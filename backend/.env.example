# ─────────────────────────────────────────────────────────────
#  StayEase Backend – Environment Variables
#  Copy this file to .env and fill in the real values.
#  NEVER commit your .env file to version control.
# ─────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────
# Supabase PostgreSQL connection string
# Format: postgresql://postgres.[PROJECT-REF]:[PASSWORD]@[HOST]:5432/postgres
DATABASE_URL=

# ── Security ──────────────────────────────────────────────────
# Strong random string used to sign JWTs — generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
JWT_SECRET=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── Google OAuth ──────────────────────────────────────────────
# Client ID from Google Cloud Console (APIs & Services > Credentials)
GOOGLE_CLIENT_ID=

# ── Gemini AI ─────────────────────────────────────────────────
# API key from Google AI Studio (https://aistudio.google.com/)
GOOGLE_API_KEY=
GEMINI_API_KEY=

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slash)
# Development:  http://localhost:5173
# Production:   https://your-app.vercel.app
ALLOWED_ORIGINS=http://localhost:5173