{
    "info": {
        "_postman_id": "9691d04b-6d06-48a5-8d40-eb9ef215f83a",
        "name": "StayEase Auth API",
        "description": "API collection for Week 6 Authentication Deliverables",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "base_url",
            "value": "http://localhost:5000",
            "type": "string"
        },
        {
            "key": "jwt_token",
            "value": "",
            "type": "string"
        }
    ],
    "item": [
        {
            "name": "Register User",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"username\": \"testuser\",\n    \"email\": \"testuser@example.com\",\n    \"password\": \"SecurePassword123!\"\n}"
                },
                "url": {
                    "raw": "{{base_url}}/api/auth/register",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "api",
                        "auth",
                        "register"
                    ]
                }
            }
        },
        {
            "name": "Login User",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "var jsonData = pm.response.json();",
                            "pm.environment.set('jwt_token', jsonData.access_token);"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"email\": \"testuser@example.com\",\n    \"password\": \"SecurePassword123!\"\n}"
                },
                "url": {
                    "raw": "{{base_url}}/api/auth/login",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "api",
                        "auth",
                        "login"
                    ]
                }
            }
        },
        {
            "name": "Create Listing (Protected)",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    },
                    {
                        "key": "Authorization",
                        "value": "Bearer {{jwt_token}}"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"name\": \"Eco-Friendly Treehouse\",\n    \"location\": \"Kerala, India\",\n    \"price\": 2500,\n    \"rating\": 4.8,\n    \"reviews\": 120,\n    \"tag\": \"Eco\",\n    \"image\": \"https://example.com/image.jpg\",\n    \"amenities\": [\n        \"WiFi\",\n        \"Solar Power\",\n        \"Organic Food\"\n    ],\n    \"description\": \"A beautiful treehouse built with sustainable materials.\",\n    \"category\": \"Treehouse\"\n}"
                },
                "url": {
                    "raw": "{{base_url}}/api/listings",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "api",
                        "listings"
                    ]
                }
            }
        },
        {
            "name": "Update Listing (Protected)",
            "request": {
                "method": "PUT",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    },
                    {
                        "key": "Authorization",
                        "value": "Bearer {{jwt_token}}"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"price\": 3000,\n    \"description\": \"Updated description\"\n}"
                },
                "url": {
                    "raw": "{{base_url}}/api/listings/1",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "api",
                        "listings",
                        "1"
                    ]
                }
            }
        }
    ]
}